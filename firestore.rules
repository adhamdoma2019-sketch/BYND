rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // True only if the signed-in person belongs to this shop AND is switched on.
    // "Belongs" is decided by their record in users/{uid}.
    function belongsTo(tenantId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData().tenantId == tenantId
        && userData().get('active', true) != false;
    }

    // Roles: owner (everything) / manager (everything except team and shop
    // settings) / staff (orders only).
    function hasRole(tenantId, roles) {
      return belongsTo(tenantId) && userData().get('role', 'staff') in roles;
    }
    function canManage(tenantId) {
      return hasRole(tenantId, ['owner', 'manager']);
    }
    function isOwner(tenantId) {
      return hasRole(tenantId, ['owner']);
    }

    function tenantIdUnchanged() {
      return request.resource.data.tenantId == resource.data.tenantId;
    }

    // ---------- Shops ----------

    match /tenants/{tenantId} {
      // The storefront needs the shop name publicly.
      allow read: if true;

      // You can only create a shop that names YOU as its owner,
      // and the shop id must equal its slug. (Create never overwrites.)
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.slug == tenantId;

      // Only the owner can change the shop's settings, and ownership can't be changed.
      allow update: if isOwner(tenantId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.slug == resource.data.slug;

      allow delete: if false;

      // ----- Activity log: who changed what, and when -----
      // Written by the team's screens (and by the server for team changes).
      // Entries can never be edited or deleted.
      match /auditLogs/{logId} {
        allow read: if canManage(tenantId);
        allow create: if belongsTo(tenantId)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.tenantId == tenantId
          && request.resource.data.get('changes', []).size() <= 30;
        allow update, delete: if false;
      }
    }

    // ---------- Who belongs to which shop ----------

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;

      // You can only link yourself to a shop that YOU own.
      // This stops anyone from adding themselves to someone else's shop.
      // (Team members are added by the secure server function instead.)
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'owner'
        && get(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.ownerUid == request.auth.uid;

      allow update, delete: if false;
    }

    // ---------- Products ----------

    match /products/{productId} {
      // Customers see only active, non-deleted products.
      // Shop staff see all products of their own shop.
      allow read: if (resource.data.isActive == true && resource.data.deleted == false)
        || belongsTo(resource.data.tenantId);

      allow create: if canManage(request.resource.data.tenantId);
      allow update: if canManage(resource.data.tenantId) && tenantIdUnchanged();
      allow delete: if false; // products are hidden (soft delete), never erased
    }

    // ---------- Product costs (PRIVATE) ----------
    // What a product costs you. Kept apart from products so customers
    // (who can read products) can never see it. Staff can't see it either.
    match /productCosts/{productId} {
      allow read: if canManage(resource.data.tenantId);

      // Can only be created for a product that belongs to the same shop.
      allow create: if canManage(request.resource.data.tenantId)
        && getAfter(/databases/$(database)/documents/products/$(productId)).data.tenantId == request.resource.data.tenantId;

      allow update: if canManage(resource.data.tenantId) && tenantIdUnchanged();
      allow delete: if false;
    }

    // ---------- Private shop settings ----------
    // e.g. the Telegram chat for order alerts. The shop record itself is
    // public, so these can't live there.
    match /tenantPrivate/{tenantId} {
      allow read, create, update: if isOwner(tenantId);
      allow delete: if false;
    }

    // ---------- Promo codes ----------
    // Only the shop's own team can see or manage codes. Customers never read
    // this collection: the secure server function checks codes for them.
    // The document id must be "<shopId>__<CODE>" so codes can't clash or be
    // squatted on by another shop.
    match /promoCodes/{promoId} {
      allow read: if canManage(resource.data.tenantId);
      allow create: if canManage(request.resource.data.tenantId)
        && promoId == request.resource.data.tenantId + '__' + request.resource.data.code;
      allow update: if canManage(resource.data.tenantId) && tenantIdUnchanged();
      allow delete: if false; // deactivate instead
    }

    // ---------- Orders ----------

    match /orders/{orderId} {
      // Orders are created ONLY by the secure server function (/api/create-order),
      // which checks real prices and stock. Browsers can never create orders.
      allow create: if false;

      allow read: if belongsTo(resource.data.tenantId);

      // Owners and managers can change anything on an order. Staff can only
      // move it through its statuses and fix the customer's details: they can't
      // touch items, prices or totals.
      allow update: if tenantIdUnchanged()
        && (canManage(resource.data.tenantId)
          || (belongsTo(resource.data.tenantId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'statusHistory', 'updatedAt', 'customer'])));

      allow delete: if false; // orders are permanent business records
    }

    // ---------- Expenses ----------

    match /expenses/{expenseId} {
      allow read: if canManage(resource.data.tenantId);
      allow create: if canManage(request.resource.data.tenantId);
      allow update: if canManage(resource.data.tenantId) && tenantIdUnchanged();
      allow delete: if false; // use the "deleted" flag instead
    }

    // ---------- Order-number counters ----------
    // Only the secure server function touches these.
    match /counters/{counterId} {
      allow read, write: if false;
    }
  }
}
